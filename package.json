{
  "name": "printpulse-agent",
  "version": "2.0.0",
  "description": "PrintPulse Agent - Desktop GUI for printer fleet monitoring",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build": "electron-builder -w"
  },
  "author": "PrintPulse Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "net-snmp": "^3.11.2",
    "node-fetch": "^2.7.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.printpulse.agent",
    "productName": "PrintPulse Agent",
    "asar": false,
    "directories": {
      "output": "dist_final"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

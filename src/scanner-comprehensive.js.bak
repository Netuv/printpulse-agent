const SUPPLY_TYPE_MAP = {
  1: 'Other', 3: 'Toner', 4: 'WasteToner', 6: 'InkRibbon',
  7: 'Opc/Drum', 8: 'Ink', 11: 'Fuser', 12: 'Staples', 13: 'WasteInk'
};


/**
 * scanner-comprehensive.js — Comprehensive SNMP Printer Scanner
 * =============================================================
 * Monitors MFP (Multi-Function Printer) via SNMP protocol
 * 
 * Features:
 *   ✅ Device info (model, serial, firmware, location)
 *   ✅ Total page counters (lifetime, BW/Color split)
 *   ✅ Toner levels (%, waste toner)
 *   ✅ Paper trays (media name, remaining sheets)
 *   ✅ Alert & error log
 *   ✅ Active jobs
 *   ✅ Vendor-specific data (Canon, Brother, Ricoh, HP, Epson, Kyocera, etc.)
 * 
 * Strategy:
 *   1. snmpy (Python GETBULK) — fastest, preferred
 *   2. net-snmp walk (Node.js) — fallback
 *   3. Manual GETNEXT walk — last resort
 * 
 * Based on RFC 3805 (Printer MIB v2) and vendor private MIBs
 * 
 * @version 2.1.0
 * @date 2026-07-06
 */

const os = require('os');
const { exec } = require('child_process');
const { promisify } = require('util');
const snmp = require('net-snmp');
const crypto = require('crypto');
const SnmpyBridge = require('./snmpy-bridge');
// Ensure snmpy resolves early (non-blocking)
setTimeout(() => SnmpyBridge.getInstance(), 10);
const OID_PROFILES = require('./oid-profiles');

const execAsync = promisify(exec);

